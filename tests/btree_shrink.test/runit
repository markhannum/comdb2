#!/usr/bin/env bash
bash -n "$0" || exit 1

# btree_shrink: each phase checks free lists and data on every node.

source ${TESTSROOTDIR}/tools/runit_common.sh
source ${TESTSROOTDIR}/tools/cluster_utils.sh

dbnm=$1
[[ "$debug" == 1 ]] && set -x

function sql { $CDB2SQL_EXE ${CDB2_OPTIONS} --tabs $dbnm default "$@"; }
function sqlh { local h=$1; shift; $CDB2SQL_EXE ${CDB2_OPTIONS} --tabs --host $h $dbnm "$@"; }
# Only btree lines (other messages share the output), without file_bytes (preallocation)
function freespace { sqlh $1 "exec procedure sys.cmd.send('freespace $2')" | grep "^$2 " | sed 's/ file_bytes [0-9]*//'; }
function shrink_status { sqlh $1 "exec procedure sys.cmd.send('shrink status')" | grep "^btree_shrink: "; }
function status { shrink_status $1 | head -1; }
function moves { status $1 | sed 's/.* moves \([0-9]*\).*/\1/'; }
function nodes { getclusternodes; }
function tun { local h=$1; shift; for t in "$@"; do sqlh $h "put tunable $t" >/dev/null || failexit "put tunable $t"; done; }

function load
{
    local lo=$1 hi=$2
    for ((i = lo; i < hi; i += 5000)); do
        sql "insert into t1 select value, printf('%0190d', value) from generate_series($i, $((i + 4999)))" >/dev/null || failexit "insert t1"
    done
}

# Btrees with little free space may be skipped, so they can stay unsorted
function unsorted_lines {
    freespace $1 $2 | grep -v "sorted 100.0%" | grep -v " free 0 " |
        awk '{ if (match($0, /\(([0-9.]+)%\)/)) { p = substr($0, RSTART + 1, RLENGTH - 3); if (p + 0 >= 2) print } }'
}

# The worker's progress counters; others tick on every idle pass
function progress { shrink_status $1 | tr ' ' '\n' | awk 'k { print k, $0; k = "" } /^(moves|trimmed|relocated|ovrewritten)$/ { k = $0 }'; }
function quiesce
{
    local m=$1 prev="" cur
    for ((q = 0; q < 60; q++)); do
        cur=$(progress $m | tr '\n' ' ')
        [[ "$cur" == "$prev" ]] && return 0
        prev=$cur
        sleep 5
    done
    failexit "worker never went idle on $m"
}

function wait_sorted
{
    local m=$1
    for ((w = 0; w < 300; w++)); do
        if [[ -z "$(unsorted_lines $m t1)" && -z "$(unsorted_lines $m t2)" ]]; then
            return 0
        fi
        sleep 1
    done
    freespace $m t1; freespace $m t2; status $m
    failexit "free lists not sorted after 300s"
}

function check_replicas
{
    local m=$1
    quiesce $m
    # A final write, then give replicas time to apply everything
    sql "insert into t1 values (-1, 'sync')" >/dev/null
    sleep 5
    freespace $m t1 > fs.master.t1; freespace $m t2 > fs.master.t2
    for n in $(nodes); do
        freespace $n t1 > fs.$n.t1; freespace $n t2 > fs.$n.t2
        diff fs.master.t1 fs.$n.t1 || failexit "t1 free lists differ on $n"
        diff fs.master.t2 fs.$n.t2 || failexit "t2 free lists differ on $n"
        grep -q incomplete fs.$n.t1 fs.$n.t2 && failexit "incomplete free-list walk on $n"
    done
    do_verify t1
    do_verify t2
}

sql "create table t1 (a int, b cstring(200))" >/dev/null || failexit "create t1"
sql "create index t1_a on t1(a)" >/dev/null || failexit "create index"
sql "create table t2 (a int, b blob)" >/dev/null || failexit "create t2"

load 1 200000
for ((i = 1; i <= 2000; i += 250)); do
    sql "insert into t2 select value, randomblob(20000) from generate_series($i, $((i + 249)))" >/dev/null || failexit "insert t2"
done
# Free the top half of t1 and most of t2: the LIFO free lists end up high-to-low
for ((i = 100000; i < 200000; i += 10000)); do
    sql "delete from t1 where a >= $i and a < $((i + 10000))" >/dev/null
done
sql "delete from t2 where a > 400" >/dev/null

master=$(getmaster)
echo "master is $master"
freespace $master t1

echo "== undo: every batch aborts after moving; free lists must be unchanged"
freespace $master t1 > fs.before.t1; freespace $master t2 > fs.before.t2
tun $master "btree_shrink_debug_abort 1" "btree_shrink 1"
sleep 10
tun $master "btree_shrink 0"
sleep 2
status $master
freespace $master t1 | diff fs.before.t1 - || failexit "t1 free lists changed by aborted batches"
freespace $master t2 | diff fs.before.t2 - || failexit "t2 free lists changed by aborted batches"
tun $master "btree_shrink_debug_abort 0"

echo "== sort under traffic"
(
    for ((r = 1; r <= 40; r++)); do
        base=$((300000 + r * 1000))
        sql "insert into t1 select value, printf('%0190d', value) from generate_series($base, $((base + 999)))" >/dev/null
        sql "delete from t1 where a >= $((base - 1000)) and a < $((base - 500))" >/dev/null
    done
) &
tun $master "btree_shrink_moves_per_txn 4" "btree_shrink_sleep_ms 1" "btree_shrink 1"
wait
wait_sorted $master
status $master
check_replicas $master

echo "== kill the master mid-sort"
# Slow the worker before freeing pages, or it sorts them before we look
tun $master "btree_shrink 0" "btree_shrink_moves_per_txn 1" "btree_shrink_sleep_ms 50"
for ((i = 20000; i < 50000; i += 5000)); do
    sql "delete from t1 where a >= $i and a < $((i + 5000))" >/dev/null
done
tun $master "btree_shrink 1"
sleep 2
m0=$(moves $master)
sleep 5
m1=$(moves $master)
[[ "$m1" -gt "$m0" ]] || failexit "no moves in flight before kill ($m0 -> $m1)"
kill_restart_node $master 1
if [[ -n "$CLUSTER" ]]; then
    wait_for_cluster
fi
sleep 5

master=$(getmaster)
echo "master is now $master"
for n in $(nodes); do
    tun $n "btree_shrink_min_file_mb 0" "btree_shrink_min_free_pct 1" "btree_shrink_pass_interval_sec 1"
done
tun $master "btree_shrink 1"
wait_sorted $master
check_replicas $master

echo "== trim, then every node truncates once its logs are gone"
function attr_all { for n in $(nodes); do for a in "$@"; do sqlh $n "exec procedure sys.cmd.send('bdb setattr $a')" >/dev/null; done; done; }
function tun_all { for n in $(nodes); do tun $n "$@"; done; }
# 1 if every btree of t1/t2 on node $1 is exactly (last_pgno + 1) pages
function truncated_on {
    local n=$1
    sqlh $n "exec procedure sys.cmd.send('freespace t1')" | grep "^t1 " > tr.$n
    sqlh $n "exec procedure sys.cmd.send('freespace t2')" | grep "^t2 " >> tr.$n
    awk '{ for (i = 1; i <= NF; i++) { if ($i == "pagesize") ps = $(i+1); if ($i == "last_pgno") lp = $(i+1);
           if ($i == "file_bytes") { fb = $(i+1); gsub(/[^0-9]/, "", fb); if (fb != (lp + 1) * ps) bad = 1 } } }
         END { exit bad }' tr.$n
}
function push_until_truncated {
    local nodes_to_check="$1"
    for ((try = 0; try < 30; try++)); do
        local all=1
        for n in $nodes_to_check; do truncated_on $n || all=0; done
        [[ $all == 1 ]] && return 0
        local last=$(sql "select max(commitlsnfile) from comdb2_transaction_commit" 2>/dev/null)
        [[ "$last" =~ ^[0-9]+$ ]] || last=$((10 + try * 2))
        sqlh $master "exec procedure sys.cmd.send('pushlogs $((last + 2)):0')" >/dev/null
        sleep 10
    done
    for n in $nodes_to_check; do echo "$n:"; cat tr.$n; done
    failexit "files not truncated on: $nodes_to_check"
}
tun_all "btree_shrink_truncate_interval_sec 2"
attr_all "LOGDELETEAGE 0" "MIN_KEEP_LOGS 1" "LOGDELETE_RUN_INTERVAL 2" "CHECKPOINTTIME 2" "PRIVATE_BLKSEQ_MAXAGE 1"
wait_sorted $master
push_until_truncated "$(nodes)"
check_replicas $master

if [[ -n "$CLUSTER" ]]; then
    echo "== a replica that keeps its logs must not truncate, and must survive the master reusing and extending"
    lag=$(for n in $(nodes); do [[ $n != $master ]] && echo $n; done | head -1)
    sqlh $lag "exec procedure sys.cmd.send('bdb setattr MIN_KEEP_LOGS 100000')" >/dev/null
    for ((i = 60000; i < 90000; i += 5000)); do
        sql "delete from t1 where a >= $i and a < $((i + 5000))" >/dev/null
    done
    sleep 20
    load 900000 960000
    sleep 10
    truncated_on $lag && echo "note: $lag had nothing pending"
    check_replicas $master
    sqlh $lag "exec procedure sys.cmd.send('bdb setattr MIN_KEEP_LOGS 1')" >/dev/null
    push_until_truncated "$(nodes)"
    check_replicas $master
fi

echo "== relocate live pages into holes, then truncate everywhere"
function relocated { shrink_status $1 | sed -n 2p | sed 's/.*relocated \([0-9]*\).*/\1/'; }
function ovrewritten { shrink_status $1 | sed -n 2p | sed 's/.*ovrewritten \([0-9]*\).*/\1/'; }
function blobsum { sqlh $1 "select a, length(b), hex(b) from t2 order by a" | md5sum | cut -d' ' -f1; }
function check_blobs {
    for n in $(nodes); do
        [[ "$(blobsum $n)" == "$blobs" ]] || failexit "t2 blob contents differ on $n"
    done
}
function rowid_lookups {
    local n=$1
    for id in $(sqlh $n "select rowid from t1 where a % 997 = 0 limit 30" | sed 's/.*rowid=\([0-9]*\).*/\1/; s/^\([0-9]*\)$/\1/'); do
        [[ -n "$(sqlh $n "select a from t1 where rowid=$id")" ]] || failexit "rowid $id not found on $n"
    done
}
master=$(getmaster)
# Empty runs of pages in the middle so the tail stays live
for ((i = 20000; i < 90000; i += 10000)); do
    sql "delete from t1 where a > $i and a <= $((i + 7000))" >/dev/null
done
sql "delete from t2 where a > 100 and a <= 300" >/dev/null
blobs=$(blobsum $master)
(
    for ((r = 1; r <= 30; r++)); do
        base=$((2000000 + r * 100))
        sql "insert into t1 select value, printf('%0190d', value) from generate_series($base, $((base + 99)))" >/dev/null
        sql "update t1 set b = 'u' || b where a between $((r * 100)) and $((r * 100 + 20))" >/dev/null
    done
) &
traffic=$!
tun $master "btree_shrink_move 1" "btree_shrink 1"
# Not a bare wait: the node restarted in phase 3 is also our child
wait $traffic
quiesce $master
shrink_status $master
[[ "$(relocated $master)" -gt 0 ]] || failexit "nothing relocated"
[[ "$(ovrewritten $master)" -gt 0 ]] || failexit "no blob chains relocated"
check_replicas $master
check_blobs
for n in $(nodes); do rowid_lookups $n; done
push_until_truncated "$(nodes)"
check_replicas $master
check_blobs
for n in $(nodes); do rowid_lookups $n; done

echo "== overflow chains straddling holes and the end of the file"
# Sorted holes make each 1 MB chain take low holes then extend the file (ovplaced).
function ovplaced { shrink_status $1 | sed -n 2p | sed 's/.*ovplaced \([0-9]*\).*/\1/'; }
function t4sum { sqlh $1 "select a, length(b), hex(b) from t4 order by a" | md5sum | cut -d' ' -f1; }
master=$(getmaster)
sql "create table t4 (a int, b blob)" >/dev/null || failexit "create t4"
for ((i = 0; i < 32; i++)); do
    sql "insert into t4 select value, randomblob(20000) from generate_series($((i * 25 + 1)), $((i * 25 + 25)))" >/dev/null
done
sql "delete from t4 where a % 2 = 0" >/dev/null
tun $master "btree_shrink_move 0" "btree_shrink_trim 0"
for ((w = 0; w < 120; w++)); do
    [[ -z "$(unsorted_lines $master t4)" ]] && break
    sleep 1
done
for ((i = 1; i <= 48; i++)); do
    sql "insert into t4 values ($((1000 + i)), randomblob(1000000))" >/dev/null || failexit "insert t4"
done
sql "delete from t4 where a <= 800" >/dev/null
t4base=$(t4sum $master)
placed=$(ovplaced $master)
tun $master "btree_shrink_move 1" "btree_shrink_trim 1"
prev=""
for ((w = 0; w < 60; w++)); do
    sleep 5
    cur="$(progress $master) $(freespace $master t4 | md5sum)"
    [[ "$cur" == "$prev" ]] && break
    prev=$cur
done
[[ "$cur" == "$prev" ]] || failexit "t4 relocation never settled"
shrink_status $master
[[ "$(ovplaced $master)" -gt "$placed" ]] || failexit "no leftover chain pages sorted into place"
sql "insert into t1 values (-2, 'sync')" >/dev/null
sleep 5
freespace $master t4 > fs.master.t4
for n in $(nodes); do
    freespace $n t4 | diff fs.master.t4 - || failexit "t4 free lists differ on $n"
    [[ "$(t4sum $n)" == "$t4base" ]] || failexit "t4 blob contents differ on $n"
done
do_verify t4

echo "Success"
