#!/usr/bin/env bash
bash -n "$0" || exit 1

# Snapshot reads of blobs on overflow pages must not see later updates.

dbname=$1
host=$(cdb2sql ${CDB2_OPTIONS} -tabs ${dbname} default "select comdb2_host()")
sql="cdb2sql ${CDB2_OPTIONS} -tabs ${dbname} --host ${host}"
nrows=20
blobsz=100000

snapsum="select id, hex(b) from t order by id"

$sql "create table t(id int primary key, b blob)" || exit 1
for i in $(seq 1 $nrows); do
    $sql "insert into t values($i, randomblob($blobsz))" > /dev/null || exit 1
done

# Snapshot reader: read all blobs, sleep while the blobs are rewritten, read again
$sql - > snap.out 2>&1 <<SQL &
set transaction snapshot isolation
begin
$snapsum
select sleep(10)
$snapsum
commit
SQL
pid=$!

sleep 3
for pass in 1 2 3; do
    for i in $(seq 1 $nrows); do
        $sql "update t set b = randomblob($blobsz) where id = $i" > /dev/null || exit 1
    done
done
wait $pid || { echo "FAIL: snapshot session failed"; cat snap.out; exit 1; }

# Keep only the "id<tab>hex" rows: first read, then second read
grep -P '^\d+\t' snap.out > rows.out
lines=$(wc -l < rows.out)
if [[ $lines -ne $((2 * nrows)) ]]; then
    echo "FAIL: unexpected snapshot output ($lines rows)"
    cut -c1-80 snap.out
    exit 1
fi
if ! diff <(head -n $nrows rows.out) <(tail -n $nrows rows.out) > /dev/null; then
    echo "FAIL: snapshot read of overflow blobs changed within transaction"
    diff <(head -n $nrows rows.out | cut -c1-40) <(tail -n $nrows rows.out | cut -c1-40)
    exit 1
fi

# Overflow pages are protected only by the lock on the leaf page that
# currently references them.  A snapshot reader locks the current leaf, but
# follows the chains referenced by the rolled-back leaf.  Collapse the blob
# btree so that the reader's leaf no longer holds the row, then rewrite the
# row's blob between the reader reading the overflow page's LSN and copying
# the page.
nrows=400
$sql "create table t2(id int primary key, b blob)" || exit 1
for i in $(seq 1 $nrows); do
    echo "insert into t2 values($i, randomblob(2000))"
done | $sql - > /dev/null || exit 1
expected=$($sql "select hex(b) from t2 where id = 1")

$sql - > snap2.out 2>&1 <<SQL &
set transaction snapshot isolation
begin
select count(*) from t2
select sleep(5)
select hex(b) from t2 where id = 1
commit
SQL
pid=$!

sleep 2
# Empty every leaf but the first: the blob btree collapses into its root
$sql "delete from t2 where id > 50" > /dev/null || exit 1
$sql "put tunable mempv_ovfl_copy_sleep_ms 10000" > /dev/null || exit 1
sleep 5
# The reader has read the overflow page's LSN; free the page and reuse it
$sql "update t2 set b = randomblob(2000) where id = 1" > /dev/null || exit 1
for i in $(seq 1001 1020); do
    echo "insert into t2 values($i, randomblob(2000))"
done | $sql - > /dev/null || exit 1
wait $pid || { echo "FAIL: snapshot session failed"; cat snap2.out; exit 1; }
$sql "put tunable mempv_ovfl_copy_sleep_ms 0" > /dev/null

got=$(grep -P '^[0-9A-F]{100}' snap2.out)
if [[ "$got" != "$expected" ]]; then
    echo "FAIL: snapshot read of overflow page raced with a writer"
    echo "expected ${expected:0:40}"
    echo "got      ${got:0:40}"
    exit 1
fi
echo "Success"
